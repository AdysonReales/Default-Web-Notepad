{
  "manifest_version": 3,
  "name": "Floating Sticky Note",
  "version": "1.2",
  "description": "Sticky notes and developer to-do lists on websites and new tabs.",

  "permissions": [
    "storage"
  ],

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}